<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign In | Sango Fiora</title>
  <script>
    var ref = document.referrer;
    var dest = '/?auth=login';
    if (ref && ref.indexOf(window.location.host) !== -1 && ref.indexOf('/login') === -1) {
      if (ref.indexOf('/admin') !== -1) {
        dest = '/?auth=login&redirect=/admin/';
      } else {
        dest = ref + (ref.indexOf('?') === -1 ? '?' : '&') + 'auth=login';
      }
    }
    window.location.replace(dest);
  </script>
</head>
<body style="background:#F8F7F4;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;">
  <div style="text-align:center;">
    <img src="/images/logo.png" alt="Sango Fiora" style="height:48px;width:auto;margin:0 auto 12px;display:block;object-fit:contain">
    <p style="color:#0F291E;font-weight:600;font-size:14px;margin-top:12px;">Opening Sign In...</p>
  </div>
</body>
</html>
